# --- Neon Postgres -------------------------------------------------------
# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/shiftbook?sslmode=require"
# Direct (unpooled) connection. Used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/shiftbook?sslmode=require"

# --- Auth.js -------------------------------------------------------------
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# --- Email (Resend) --------------------------------------------------------
# API key from https://resend.com/api-keys. Without it, in development the code and
# link are printed in the terminal instead of emailed.
RESEND_API_KEY=""
# Sender. "onboarding@resend.dev" works without a domain but only delivers to the
# email address you signed up to Resend with. Verify your own domain to email anyone.
EMAIL_FROM="ShiftBook <onboarding@resend.dev>"
# Public address used in email links, e.g. https://shiftbook.vercel.app (optional locally)
APP_URL=""
# Set to "false" to skip email confirmation (not recommended)
REQUIRE_EMAIL_VERIFICATION="true"

# --- App -----------------------------------------------------------------
# Time zone used to work out "today", overdue payments and the current week.
APP_TIMEZONE="Australia/Sydney"
# Every login ends after this many days, even for active users (auto logout after
# inactivity is set per user in Profile). Default 30.
SESSION_MAX_DAYS="30"
# Set to "false" after creating your account so nobody else can sign up.
ALLOW_SIGNUP="true"

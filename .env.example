# --- Neon Postgres -------------------------------------------------------
# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/shiftbook?sslmode=require"
# Direct (unpooled) connection. Used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/shiftbook?sslmode=require"

# --- Auth.js -------------------------------------------------------------
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# --- App -----------------------------------------------------------------
# Time zone used to work out "today", overdue payments and the current week.
APP_TIMEZONE="Australia/Sydney"
# Set to "false" after creating your account so nobody else can sign up.
ALLOW_SIGNUP="true"
